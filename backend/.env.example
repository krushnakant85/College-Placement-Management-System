# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Configuration (optional in production, comma-separated allowed origins)
# CORS_ORIGIN=https://placement.yourcollege.edu

# MySQL Database Configuration (Supports both DB_* and DATABASE_* formats)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password_here
DB_NAME=college_placement_system
# DB_SSL=false

# Alternative Standard Cloud Variables:
# DATABASE_HOST=your-production-db-host
# DATABASE_PORT=3306
# DATABASE_USER=your_production_user
# DATABASE_PASSWORD=your_production_password
# DATABASE_NAME=college_placement_system
# DATABASE_SSL=false

# Java Eligibility Engine Configuration (optional path override)
# JAVA_BIN_DIR=./java/bin
